node-linker=isolated

# Pin the .pnpm virtual-store directory name length so it is identical on
# Windows (pnpm default 60) and Linux/EAS (pnpm default 120). Those paths are
# hashed into the Expo fingerprint, so a mismatch here breaks
# runtimeVersion.policy = "fingerprint" on EAS Build.
virtual-store-dir-max-length=60
