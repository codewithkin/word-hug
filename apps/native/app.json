{
  "expo": {
    "scheme": "word-hug",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "word-hug",
    "slug": "word-hug",
    "plugins": [
      "expo-font",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.codewithkin.wordhug"
    }
  }
}
