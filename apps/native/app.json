{
  "expo": {
    "name": "Word Hug",
    "slug": "word-hug",
    "version": "1.0.0",
    "scheme": "word-hug",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.codewithkin.wordhug",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.codewithkin.wordhug",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFF4E2"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FFF4E2",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#1A0F38"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFB020"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {},
          "ios": {}
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0770a562-9212-4a59-9042-1a535c7bc086"
      },
      "revenueCatKeys": {
        "android": "goog_MxoUQgmEwbXCfKMmWHfrojCnpRb",
        "ios": ""
      }
    },
    "owner": "codewithkin",
    "updates": {
      "url": "https://u.expo.dev/0770a562-9212-4a59-9042-1a535c7bc086"
    }
  }
}
