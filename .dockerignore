# Build context for `docker build -f apps/web/Dockerfile .`
#
# Everything here is either reinstalled inside the image, regenerated by the
# build, or belongs to the Expo app — which this image never touches.

node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
.git
.gitattributes
.env*.local
*.log

# Native-only. The web image never builds apps/native, but these directories are
# large and the daemon would walk them into the context regardless.
**/android
**/ios
**/.expo
apps/native

# ── The design exports ────────────────────────────────────────────────────
# 8.8 MB across 140 HTML files. They are the source the app's screens were
# built from and are never imported by anything — not by Metro, not by Next.
# Left in the context they would be the single largest thing shipped to the
# Docker daemon on every build.
designs

# Documentation and planning. Read by people and by agents, never by a build.
plans
progress
systems

# Node-only tooling: the level bank builder, the check scripts, the Datamuse
# validators. They run in CI and on a laptop; nothing in the image calls them.
scripts

# Scratch config from a scoped typecheck. Should not exist; ignored so a stray
# copy cannot change the build.
**/tsconfig.scope.json
