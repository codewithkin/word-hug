# ── Line endings ───────────────────────────────────────────────────────────
#
# Every text file is LF in the repository. Git converts on checkout for anyone
# whose tooling wants CRLF, so this changes nothing about how you edit.
#
# ── Why this file exists ───────────────────────────────────────────────────
# The repo was committed from Windows with CRLF endings and is edited by tools
# that write LF. With no `.gitattributes` and `core.autocrlf` unset, git treats
# an ending flip as a content change, so `plans/01-prd.md` showed up as
# "542 insertions, 542 deletions" in a session that never opened it.
#
# That is not cosmetic. A diff where 70 files changed and 8 of them are real is
# a diff nobody reads, which is exactly how a bad line ships in a file the
# author thought was untouched. Normalising once makes every later diff mean
# something.
#
# Apply the one-time normalisation with:
#     git add --renormalize .
#
* text=auto eol=lf

# ── Binaries ───────────────────────────────────────────────────────────────
# Never touched, never diffed as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.mp4   binary
*.keystore binary
*.jks   binary

# ── Generated ──────────────────────────────────────────────────────────────
# Real files that are checked in and must stay in sync, but which a human never
# hand-edits. Marked so review tools can collapse them by default — the source
# of truth is the script named in each file's header.
apps/native/theme.generated.css            linguist-generated=true
apps/native/theme/token-map.generated.ts   linguist-generated=true
apps/native/content/levels.ts              linguist-generated=true
apps/native/content/pack-levels.ts         linguist-generated=true

# Lockfiles: keep them, never review them.
pnpm-lock.yaml  -diff linguist-generated=true
